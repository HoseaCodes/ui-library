{
  "name": "uilibrary",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/uiheat"
  ],
  "dependencies": {
    "@testing-library/jest-dom": "^5.11.8",
    "@testing-library/react": "^11.2.3",
    "@testing-library/user-event": "^12.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.1.0",
    "react-scripts": "^5.0.1",
    "styled-components": "^5.2.1",
    "web-vitals": "^0.2.4",
    "uiheat": "*"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lib:build": "npm run build-lib -w uiheat",
    "lib:storybook": "npm run storybook -w uiheat",
    "docs:install": "npm install --prefix packages/uiheat/docs",
    "docs:start": "npm start --prefix packages/uiheat/docs",
    "docs:build": "npm run build --prefix packages/uiheat/docs",
    "registry:build": "npm run check --prefix registry",
    "registry:serve": "npm run serve --prefix registry"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
